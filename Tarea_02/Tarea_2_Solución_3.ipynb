        "puntaje1 = int(input(\"Ingresa primer puntaje\"))\n",
        "puntaje2 = int(input(\"Ingresa segundo puntaje\"))\n",
        "suma = puntaje1 + puntaje2\n",
        "if suma < 50:\n",
        "  nivel = \"Nivel principiante\"\n",
        "elif 50 <= suma < 80:\n",
        "  nivel = \"Nivel intermedio\"\n",
        "else:\n",
        "  nivel = \"Nivel pro\"\n",
        "\n",
        "print(f\"\\nResultado: {nivel}\")"
      ]
